import React from 'react';
import { useAppDispatch, useAppSelector } from '../store/hooks';
import {
  setSearchQuery,
  setStatusFilter,
  setSortBy,
} from '../store/slices/filtersSlice';
import { selectFilters } from '../store/selectors';
import type { SortBy, TimerStatus } from '../types/timer';
import { Button, Input, Select } from '../components/common';
import { Search, Plus } from 'lucide-react';

interface ControlBarReduxProps {
  onCreateTimer: () => void;
  timersCount: number;
}

export const ControlBarRedux: React.FC<ControlBarReduxProps> = ({
  onCreateTimer,
  timersCount,
}) => {
  const dispatch = useAppDispatch();
  const filters = useAppSelector(selectFilters);

  const statusOptions = [
    { value: 'all', label: 'All Status' },
    { value: 'running', label: 'Running' },
    { value: 'paused', label: 'Paused' },
    { value: 'idle', label: 'Idle' },
  ];

  const sortOptions = [
    { value: 'createdAt', label: 'Sort by Created' },
    { value: 'elapsed', label: 'Sort by Elapsed' },
    { value: 'name', label: 'Sort by Name' },
  ];

  return (
    <section className="bg-white border-2 border-gray-200 rounded-lg p-4 mb-6" aria-label="Timer controls and filters">
      <div className="flex flex-col md:flex-row gap-4">
        <div className="flex-1">
          <Input
            id="search-timers"
            type="search"
            placeholder="Search timers..."
            value={filters.searchQuery}
            onChange={(event) => dispatch(setSearchQuery(event.target.value))}
            leftIcon={<Search className="w-4 h-4" />}
            fullWidth
            aria-label="Search timers"
          />
        </div>

        <Select
          id="status-filter"
          value={filters.status}
          onChange={(event) =>
            dispatch(setStatusFilter(event.target.value as TimerStatus))
          }
          options={statusOptions}
          aria-label="Filter timers by status"
        />

        <Select
          id="sort-by"
          value={filters.sortBy}
          onChange={(event) =>
            dispatch(setSortBy(event.target.value as SortBy))
          }
          options={sortOptions}
          aria-label="Sort timers"
        />

        <Button
          variant="primary"
          onClick={onCreateTimer}
          leftIcon={<Plus className="w-4 h-4" />}
          aria-label="Create new timer"
        >
          New Timer
        </Button>
      </div>

      <div className="mt-3 text-sm text-gray-600" role="status" aria-live="polite">
        Showing {timersCount} {timersCount === 1 ? 'timer' : 'timers'}
      </div>
    </section>
  );
};
